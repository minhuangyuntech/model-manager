{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Model Manager",
  "version": "0.1.0",
  "identifier": "local.modelmanager.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "本地模型管理員", "width": 1120, "height": 760, "minWidth": 640, "minHeight": 460 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
